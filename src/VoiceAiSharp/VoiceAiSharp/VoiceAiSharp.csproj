<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VoiceAiSharp</AssemblyName>
    <RootNamespace>VoiceAiSharp</RootNamespace>
    <PackageId>VoiceAiSharp</PackageId>
    <Title>VoiceAiSharp</Title>
    <Authors>VoiceAiSharp contributors</Authors>
    <Description>AI-powered text-to-speech for .NET with a simple, provider-agnostic API.</Description>
    <PackageTags>tts;text-to-speech;ai;onnx;piper;kokoro</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TtsOnnxRuntimeProvider Condition="'$(TtsOnnxRuntimeProvider)' == ''">Cpu</TtsOnnxRuntimeProvider>
    <OnnxRuntimeVersion>1.27.0</OnnxRuntimeVersion>
    <OnnxRuntimeDirectMlVersion>1.24.4</OnnxRuntimeDirectMlVersion>
    <PhonemizerRoot Condition="'$(PhonemizerRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\Libraries\Avalon\Service\Phonemizer\</PhonemizerRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(TtsOnnxRuntimeProvider)' == 'Cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TtsOnnxRuntimeProvider)' == 'Cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="$(OnnxRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TtsOnnxRuntimeProvider)' == 'DirectML'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="$(OnnxRuntimeDirectMlVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PhonemizerRoot)Libraries\Native\Win-x64\**\*">
      <Link>Application\Providers\EspeakNgNativeService\Libraries\Native\Win-x64\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>Application\Providers\EspeakNgNativeService\Libraries\Native\Win-x64\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes\win-x64\native\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PhonemizerSharp" Version="0.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Engines\Providers\KokoroService\Libraries\Native\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateTtsOnnxRuntimeProvider" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TtsOnnxRuntimeProvider)' != 'Cpu' and '$(TtsOnnxRuntimeProvider)' != 'Cuda' and '$(TtsOnnxRuntimeProvider)' != 'DirectML'" Text="Unsupported TtsOnnxRuntimeProvider '$(TtsOnnxRuntimeProvider)'. Use Cpu, Cuda, or DirectML." />
  </Target>

  <Target Name="ValidatePhonemizerRoot" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PhonemizerRoot)Avalon.Base.Extension.dll')" Text="Avalon.Base.Extension.dll was not found. Set PhonemizerRoot to the folder containing the phonemizer assemblies." />
    <Error Condition="!Exists('$(PhonemizerRoot)Avalon.Service.Phonemizer.dll')" Text="Avalon.Service.Phonemizer.dll was not found. Set PhonemizerRoot to the folder containing the phonemizer assemblies." />
  </Target>

</Project>
